<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <theme>
    <name>custom</name>
    <cornerRadius>20</cornerRadius>
    <font name="JetBrainsMono Nerd Font" size="10" />
  </theme>

  <core>
    <decoration>server</decoration>
    <gap>10</gap>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <focus>
    <followMouse>no</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <desktops number="9" popupTime="1000" prefix="Workspace" />

  <keyboard>
    <default />
    <numlock>on</numlock>
    <layoutScope>global</layoutScope>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>

    <keybind key="W-Return">
      <action name="Execute" command="kitty" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="firefox" />
    </keybind>
    <keybind key="W-Space">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <keybind key="W-s">
      <action name="Execute" command="noctalia msg panel-toggle control-center" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="kitty -e yazi" />
    </keybind>
    <keybind key="W-S-e">
      <action name="Execute" command="nautilus" />
    </keybind>
    <keybind key="W-v">
      <action name="Execute" command="noctalia msg panel-toggle clipboard" />
    </keybind>
    <keybind key="C-S-Escape">
      <action name="Execute" command="kitty -e btop" />
    </keybind>

    <keybind key="W-l">
      <action name="Execute" command="noctalia msg session lock" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Exit" />
    </keybind>
    <keybind key="W-S-p">
      <action name="Execute" command="sh -c 'command -v wlopm >/dev/null 2&gt;&amp;1 &amp;&amp; wlopm --off &quot;*&quot;'" />
    </keybind>

    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="noctalia msg volume-up" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="noctalia msg volume-down" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="noctalia msg volume-mute" />
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="noctalia msg mic-mute" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="noctalia msg brightness-up" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="noctalia msg brightness-down" />
    </keybind>

    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="W-Left">
      <action name="ToggleSnapToEdge" direction="left" combine="yes" />
    </keybind>
    <keybind key="W-Down">
      <action name="ToggleSnapToEdge" direction="down" combine="yes" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleSnapToEdge" direction="up" combine="yes" />
    </keybind>
    <keybind key="W-Right">
      <action name="ToggleSnapToEdge" direction="right" combine="yes" />
    </keybind>

    <keybind key="W-S-Left">
      <action name="FocusOutput" direction="left" />
    </keybind>
    <keybind key="W-S-Down">
      <action name="FocusOutput" direction="down" />
    </keybind>
    <keybind key="W-S-Up">
      <action name="FocusOutput" direction="up" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="FocusOutput" direction="right" />
    </keybind>
    <keybind key="W-C-S-Left">
      <action name="MoveToOutput" direction="left" />
    </keybind>
    <keybind key="W-C-S-Down">
      <action name="MoveToOutput" direction="down" />
    </keybind>
    <keybind key="W-C-S-Up">
      <action name="MoveToOutput" direction="up" />
    </keybind>
    <keybind key="W-C-S-Right">
      <action name="MoveToOutput" direction="right" />
    </keybind>

    <keybind key="W-Page_Down">
      <action name="GoToDesktop" to="right" wrap="yes" />
    </keybind>
    <keybind key="W-Page_Up">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="W-u">
      <action name="GoToDesktop" to="right" wrap="yes" />
    </keybind>
    <keybind key="W-i">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="W-C-Page_Down">
      <action name="SendToDesktop" to="right" follow="no" wrap="yes" />
    </keybind>
    <keybind key="W-C-Page_Up">
      <action name="SendToDesktop" to="left" follow="no" wrap="yes" />
    </keybind>
    <keybind key="W-C-u">
      <action name="SendToDesktop" to="right" follow="no" wrap="yes" />
    </keybind>
    <keybind key="W-C-i">
      <action name="SendToDesktop" to="left" follow="no" wrap="yes" />
    </keybind>

    <keybind key="W-1"><action name="GoToDesktop" to="1" toggle="yes" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" toggle="yes" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" toggle="yes" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" toggle="yes" /></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5" toggle="yes" /></keybind>
    <keybind key="W-6"><action name="GoToDesktop" to="6" toggle="yes" /></keybind>
    <keybind key="W-7"><action name="GoToDesktop" to="7" toggle="yes" /></keybind>
    <keybind key="W-8"><action name="GoToDesktop" to="8" toggle="yes" /></keybind>
    <keybind key="W-9"><action name="GoToDesktop" to="9" toggle="yes" /></keybind>

    <keybind key="W-C-1"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-C-2"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-C-3"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-C-4"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <keybind key="W-C-5"><action name="SendToDesktop" to="5" follow="no" /></keybind>
    <keybind key="W-C-6"><action name="SendToDesktop" to="6" follow="no" /></keybind>
    <keybind key="W-C-7"><action name="SendToDesktop" to="7" follow="no" /></keybind>
    <keybind key="W-C-8"><action name="SendToDesktop" to="8" follow="no" /></keybind>
    <keybind key="W-C-9"><action name="SendToDesktop" to="9" follow="no" /></keybind>

    <keybind key="W-comma">
      <action name="Execute" command="noctalia msg settings-toggle" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-S-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="W-m">
      <action name="Maximize" />
    </keybind>
    <keybind key="W-Escape">
      <action name="ToggleKeybinds" />
    </keybind>

    <keybind key="XF86Calculator">
      <action name="Execute" command="gnome-calculator" />
    </keybind>
    <keybind key="XF86Favorites">
      <action name="Execute" command="spotify-launcher" />
    </keybind>
    <keybind key="W-p">
      <action name="Execute" command="nwg-displays" />
    </keybind>
    <keybind key="W-S-F23">
      <action name="Execute" command="kitty -e copilot" />
    </keybind>
    <keybind key="W-S-c">
      <action name="Reconfigure" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="non-touch">
      <naturalScroll>no</naturalScroll>
      <pointerSpeed>0.2</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
      <scrollFactor>1.0</scrollFactor>
    </device>
    <device category="touchpad">
      <naturalScroll>no</naturalScroll>
      <tap>yes</tap>
      <disableWhileTyping>yes</disableWhileTyping>
      <pointerSpeed>0.2</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
      <clickMethod>buttonAreas</clickMethod>
      <scrollMethod>twofinger</scrollMethod>
      <tapButtonMap>lrm</tapButtonMap>
      <scrollFactor>1.0</scrollFactor>
    </device>
    <device category="default">
      <tap>yes</tap>
      <naturalScroll>no</naturalScroll>
      <disableWhileTyping>yes</disableWhileTyping>
      <pointerSpeed>0.2</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
      <clickMethod>buttonAreas</clickMethod>
      <scrollMethod>twofinger</scrollMethod>
      <tapButtonMap>lrm</tapButtonMap>
      <scrollFactor>1.0</scrollFactor>
    </device>
  </libinput>

  <windowRules>
    <windowRule identifier="dev.noctalia.Noctalia.Settings">
      <action name="ResizeTo" width="1080" height="920" />
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <windowRule identifier="firefox" title="Picture-in-Picture">
      <action name="ToggleAlwaysOnTop" />
      <action name="ResizeTo" width="480" height="270" />
      <action name="AutoPlace" policy="cursor" />
    </windowRule>
    <windowRule identifier="firefox" title="*Bitwarden*">
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <windowRule identifier="org.gnome.Calculator">
      <action name="ResizeTo" width="360" height="540" />
      <action name="AutoPlace" policy="center" />
    </windowRule>
  </windowRules>

  <menu>
    <ignoreButtonReleasePeriod>250</ignoreButtonReleasePeriod>
    <showIcons>yes</showIcons>
  </menu>
</labwc_config>
