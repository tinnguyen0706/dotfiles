<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="client-menu">
    <item label="Minimize">
      <action name="Iconify" />
    </item>
    <item label="Maximize">
      <action name="ToggleMaximize" />
    </item>
    <item label="Fullscreen">
      <action name="ToggleFullscreen" />
    </item>
    <item label="Roll Up/Down">
      <action name="ToggleShade" />
    </item>
    <item label="Decorations">
      <action name="ToggleDecorations" />
    </item>
    <item label="Always on Top">
      <action name="ToggleAlwaysOnTop" />
    </item>
    <item label="Close">
      <action name="Close" />
    </item>
  </menu>

  <menu id="root-menu">
    <item label="Terminal">
      <action name="Execute" command="kitty" />
    </item>
    <item label="Yazi">
      <action name="Execute" command="kitty -e yazi" />
    </item>
    <item label="Files">
      <action name="Execute" command="nautilus" />
    </item>
    <separator />
    <item label="Firefox">
      <action name="Execute" command="firefox" />
    </item>
    <item label="Launcher">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </item>
    <item label="Control Center">
      <action name="Execute" command="noctalia msg panel-toggle control-center" />
    </item>
    <item label="Clipboard">
      <action name="Execute" command="noctalia msg panel-toggle clipboard" />
    </item>
    <separator />
    <item label="Btop">
      <action name="Execute" command="kitty -e btop" />
    </item>
    <item label="Display Settings">
      <action name="Execute" command="nwg-displays" />
    </item>
    <separator />
    <item label="Reconfigure">
      <action name="Reconfigure" />
    </item>
    <item label="Exit">
      <action name="Exit" />
    </item>
  </menu>
</openbox_menu>
