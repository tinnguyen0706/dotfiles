# labwc autostart - based on niri spawn-at-startup

# Set background (using swaybg or wbg)
swaybg -c '#1e1e2e' >/dev/null 2>&1 &

# Configure outputs (from niri monitor.kdl)
# eDP-1: 1920x1080@144, scale 1.0, position 0,0
wlr-randr --output eDP-1 --mode 1920x1080@144.003 --scale 1.0 --pos 0,0 >/dev/null 2>&1 &

# Launch panel (waybar)
waybar >/dev/null 2>&1 &

# Enable notifications
mako >/dev/null 2>&1 &

# Lock screen after 5 minutes; turn off display after another 5 minutes
swayidle -w \
	timeout 300 'swaylock -f -c 1e1e2e' \
	timeout 600 'wlopm --off *' \
	resume 'wlopm --on *' \
	before-sleep 'swaylock -f -c 1e1e2e' >/dev/null 2>&1 &

# Niri autostart apps
noctalia >/dev/null 2>&1 &
fcitx5 -d >/dev/null 2>&1 &
(sleep 5 && exec flatpak run dev.vencord.Vesktop --no-sandbox --enable-speech-dispatcher --ozone-platform=wayland --enable-wayland-ime --wayland-text-input-version=3 --start-minimized) >/dev/null 2>&1 &