// Include monitor configuration generated by nwg-displays
include "monitor.kdl"

// =============================================================================
// Niri Configuration
// https://niri-wm.github.io/niri/Configuration:-Introduction
// =============================================================================

// -----------------------------------------------------------------------------
// Environment Variables
// -----------------------------------------------------------------------------
environment {
    MOZ_DISABLE_RDD_SANDBOX "1"
    LIBVA_DRIVER_NAME "nvidia"
    __EGL_VENDOR_LIBRARY_FILENAMES "/usr/share/glvnd/egl_vendor.d/10_nvidia.json"
    CUDA_DISABLE_PERF_BOOST "1"
}

// -----------------------------------------------------------------------------
// Input
// -----------------------------------------------------------------------------
input {
    // disable-power-key-handling
    workspace-auto-back-and-forth
    mod-key "Super"

    keyboard {
        track-layout "global"
        numlock
        xkb {
            layout "us"
            variant "us"
        }
        repeat-delay 600
        repeat-rate 25
    }

    touchpad {
        dwtp
        dwt
        tap
        natural-scroll
        drag false
        click-method "button-areas"
        scroll-method "two-finger"
        accel-speed 0.2
        accel-profile "adaptive"
        tap-button-map "left-right-middle"
        scroll-factor 1.0
    }

    mouse {
        accel-speed 0.2
        accel-profile "adaptive"
        scroll-factor 1.0
    }
}

// -----------------------------------------------------------------------------
// Output
// -----------------------------------------------------------------------------
output "eDP-1" {
    mode "1920x1080@144.003"
    scale 1.0
    transform "normal"
    position x=-1742 y=-127
}

// -----------------------------------------------------------------------------
// Layout
// -----------------------------------------------------------------------------
layout {
    gaps 10
    default-column-display "normal"
    default-column-width { proportion 1.0; }
    center-focused-column "never"

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    focus-ring {
        on
        width 2
        active-color "#000000"
        inactive-color "#505050"
    }

    border {
        off
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    shadow {
        on
        softness 40
        spread 2
        offset x=0 y=6
        color "#00000050"
    }

    insert-hint {
        color "#ffc87f70"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        corner-radius 4
        width 4
        length total-proportion=1.0
        gap 4
        gaps-between-tabs 2
    }
}

// -----------------------------------------------------------------------------
// Overview
// -----------------------------------------------------------------------------
overview {
    zoom 0.4
}

// -----------------------------------------------------------------------------
// Animations
// -----------------------------------------------------------------------------
animations {
    on
    slowdown 1.0
    window-open { curve "cubic-bezier" 0.25 0.1 0.25 1.0; }
    config-notification-open-close { curve "cubic-bezier" 0.25 0.1 0.25 1.0; }
    window-close { curve "cubic-bezier" 0.25 0.1 0.25 1.0; }
    window-movement { curve "cubic-bezier" 0.25 0.1 0.25 1.0; }
    window-resize { curve "cubic-bezier" 0.25 0.1 0.25 1.0; }
    workspace-switch { curve "cubic-bezier" 0.25 0.1 0.25 1.0; }
    horizontal-view-movement { curve "cubic-bezier" 0.25 0.1 0.25 1.0; }
    overview-open-close { curve "cubic-bezier" 0.25 0.1 0.25 1.0; }
    screenshot-ui-open { curve "cubic-bezier" 0.25 0.1 0.25 1.0; }
}

// -----------------------------------------------------------------------------
// Blur
// -----------------------------------------------------------------------------
blur {
    passes 2
    offset 2.0
    noise 0.015
}

// -----------------------------------------------------------------------------
// Cursor
// -----------------------------------------------------------------------------
cursor {
    hide-when-typing
    xcursor-theme "Bibata-Modern-Ice"
}

// -----------------------------------------------------------------------------
// Gestures
// -----------------------------------------------------------------------------
gestures {
    hot-corners {
        top-left
    }
}

// -----------------------------------------------------------------------------
// Hotkey Overlay
// -----------------------------------------------------------------------------
hotkey-overlay {
    hide-not-bound
    skip-at-startup
}

// -----------------------------------------------------------------------------
// Debug
// -----------------------------------------------------------------------------
debug {
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}

// -----------------------------------------------------------------------------
// Screenshots
// -----------------------------------------------------------------------------
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// -----------------------------------------------------------------------------
// Startup
// -----------------------------------------------------------------------------
spawn-at-startup "noctalia"
spawn-at-startup "fcitx5" "-d"
spawn-sh-at-startup "sleep 3 && exec systemctl --user start warp-taskbar.service"
spawn-sh-at-startup "sleep 3 && exec waywallen --no-ui"
spawn-sh-at-startup "sleep 3 && exec ABDownloadManager --background"
spawn-sh-at-startup "sleep 3 && exec zalo"
spawn-sh-at-startup "sleep 3 && exec flatpak run dev.vencord.Vesktop --no-sandbox --enable-speech-dispatcher --ozone-platform=wayland --enable-wayland-ime --wayland-text-input-version=3 --start-minimized"
 
// -----------------------------------------------------------------------------
// Window Rules
// -----------------------------------------------------------------------------

// Frosted glass base: all windows
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    draw-border-with-background false
    opacity 0.82
    background-effect {
        blur true
        xray false
    }
}

// Keep one opacity threshold for consistent wallpaper visibility
window-rule {
    match is-focused=true
    opacity 0.82
    background-effect {
        blur true
    }
}

// Kitty handles its own background transparency; keep terminal text opaque
window-rule {
    match app-id="kitty"
    opacity 1.0
}

// Floating Noctalia settings window
window-rule {
    match app-id="dev.noctalia.Noctalia.Settings"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Firefox picture-in-picture as floating
window-rule {
    match app-id=r"firefox$" title="^Picture-in-Picture$"
    open-floating true
}

// Bitwarden extension: floating
window-rule {
    match app-id="firefox" title=r"^(Bitwarden|Extension:.*Bitwarden)"
    open-floating true
}

// Calculator: floating
window-rule {
    match app-id="org.gnome.Calculator"
    open-floating true
    default-column-width { fixed 360; }
    default-window-height { fixed 540; }
}

// -----------------------------------------------------------------------------
// Layer Rules
// -----------------------------------------------------------------------------
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// -----------------------------------------------------------------------------
// Key Bindings
// -----------------------------------------------------------------------------
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // -- Launch apps ----------------------------------------------------------
    Mod+Return hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+B hotkey-overlay-title="Open Browser: firefox" { spawn "firefox"; }
    Mod+Space  { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S      { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+E      { spawn-sh "kitty -e yazi"; }
    Mod+Shift+E hotkey-overlay-title="File Manager: nautilus" { spawn "nautilus"; }
    Mod+V      { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Ctrl+Shift+Escape { spawn-sh "kitty -e btop"; }

    // -- Session --------------------------------------------------------------
    Super+L hotkey-overlay-title="Lock the Screen: noctalia" { spawn-sh "noctalia msg session lock"; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P     { power-off-monitors; }

    // -- Audio & Brightness ----------------------------------------------------
    XF86AudioRaiseVolume  { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute      { spawn-sh "noctalia msg mic-mute"; }
    XF86MonBrightnessUp   { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

    // -- Overview -------------------------------------------------------------
    Mod+O repeat=false { toggle-overview; }

    // -- Window management ----------------------------------------------------
    Mod+Q repeat=false { close-window; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    // Move windows
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    // Focus first/last
    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // -- Monitor focus & move -------------------------------------------------
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // -- Workspace navigation -------------------------------------------------
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // -- Workspace by index ---------------------------------------------------
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // -- Mouse wheel (workspace & column) -------------------------------------
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // -- Column management ----------------------------------------------------
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Period       { expel-window-from-column; }

    // -- Resize ---------------------------------------------------------------
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // -- Layout ---------------------------------------------------------------
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M       { maximize-window-to-edges; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+C       { center-column; }
    Mod+Ctrl+C  { center-visible-columns; }

    // -- Floating & tabs ------------------------------------------------------
    Mod+T       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W       { toggle-column-tabbed-display; }

    // -- Screenshots ----------------------------------------------------------
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // -- Misc -----------------------------------------------------------------
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // -- Fn keys --------------------------------------------------------------
    XF86Calculator              { spawn "gnome-calculator"; }
    XF86Favorites               { spawn "spotify-launcher"; }
    Super+P                     { spawn "nwg-displays"; }
    Super+Shift+F23             { spawn-sh "kitty -e copilot"; } // Copilot
}

// -----------------------------------------------------------------------------
// Include (noctalia theme)
// -----------------------------------------------------------------------------
include "noctalia.kdl"

include "noctalia.kdl"
