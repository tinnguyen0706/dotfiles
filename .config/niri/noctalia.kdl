layout {

    focus-ring {
        active-color   "#455e91"
        inactive-color "#faf9ff"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#455e91"
        inactive-color "#faf9ff"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#455e91"
        inactive-color "#d8e2ff"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#455e9180"
    }
}

recent-windows {
    highlight {
        active-color "#455e91"
        urgent-color "#ba1a1a"
    }
}
